{
  "plugins": [
    [
      "module-resolver",
      {
        "root": ["./src"],
        "extensions": [".ios.js", ".android.js", ".js", ".ts", ".tsx", ".json"],
        "alias": {
          "tests": ["./tests/"],
          "@components": "./src/components",
          "@types": ["./src/types/*"],
          "@screens": ["./src/screens/*"],
          "@navigation": ["./src/navigation/*"],
          "@hooks": ["./src/hooks/*"],
          "@utils": ["./src/utils/*"],
          "@constants": ["./src/constants/*"],
          "@services": ["./src/services/*"]
        }
      }
    ]
  ]
}
